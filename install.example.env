# Answers file for `./install.sh --config install.example.env`.
#
# Every key is optional; the installer falls back to a prompt, then to the
# default shown here. Copy this file, edit it, and keep the copy out of git:
# it carries the bot token and the updater token.
#
#   cp install.example.env install.local.env
#   ./install.sh --config install.local.env --check     # see the plan
#   ./install.sh --config install.local.env             # apply it

# docker (default) or native. Native needs root and systemd.
MODE=docker

# native only: sandbox (default) or privileged (adds the docker group).
# TIER=sandbox

# Where the deployment lives. docker defaults to this checkout, native to /srv/dsh.
# DIR=/srv/dsh

# native only: the unprivileged user that runs the runtime.
# SERVICE_USER=dsh

# The web UI. DSH_BIND_IP must exist on the machine; 127.0.0.1 keeps it host-only.
DSH_PORT=4310
DSH_BIND_IP=127.0.0.1

# Model route.
DSH_PROVIDER=opencode-go
DSH_MODEL=deepseek-v4.1-flash

# The provider key. Written under the name the route reads
# (OPENCODE_GO_API_KEY for opencode-go, DEEPSEEK_API_KEY for deepseek-official).
# Left blank, the installer prints how to add it later.
PROVIDER_KEY=

# Telegram. Blank disables the connector; then ALLOWED_USER_IDS is left alone.
DSH_TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# Bearer token for the privileged updater. Blank makes the installer generate
# one. Treat it as a root credential.
DSH_UPDATER_TOKEN=
