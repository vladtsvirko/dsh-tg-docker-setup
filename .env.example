# Copy to .env and fill in. `docker compose` reads this file automatically.

# ---- image ---------------------------------------------------------------
# UID/GID that owns ./data on the host. Check with `id -u; id -g`.
DSH_UID=1000
DSH_GID=1000

# ---- network -------------------------------------------------------------
# Host interface the web UI is published on. MUST be an address that exists on
# this machine — docker refuses to start otherwise ("cannot assign requested
# address"). 127.0.0.1 keeps it host-only, but then DSH_PUBLIC_URL is required
# (see below), or the UI dials the container address and reconnects forever.
#
#   Your LAN IP:  ip route get 1.1.1.1 | awk '{print $7; exit}'
DSH_BIND_IP=127.0.0.1
DSH_PORT=4310
# The root the browser is told to dial, and the only authority the web app
# trusts. Defaults to http://$DSH_BIND_IP:$DSH_PORT/ when DSH_BIND_IP isn't
# 127.0.0.1. Set it when you reach dsh through a hostname, reverse proxy, VPN
# name or SSH tunnel — for host-only mode that is
# DSH_PUBLIC_URL=http://127.0.0.1:4310/ (with ssh -L 4310:127.0.0.1:4310).
# DSH_PUBLIC_URL=http://nas.local:4310/
DSH_MEM_LIMIT=4g
DSH_CPUS=2.0

# ---- model route (required) ----------------------------------------------
# Default here: the opencode-go route. The entrypoint registers it on the pi-ai
# plugin and pins it as the new-session default model.
DSH_PROVIDER=opencode-go
DSH_MODEL=deepseek-v4.1-flash
OPENCODE_GO_API_KEY=

# Alternative: the DeepSeek platform route. Set these and empty/remove the
# opencode-go key; install.sh rewrites the managed block, so there is no need to
# comment lines out by hand. Switching is an .env edit + restart (no rebuild).
# DSH_PROVIDER=deepseek-official
# DSH_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=

# Only for providers whose key variable is neither of the above.
# DSH_PROVIDER_API_KEY_ENV=

# Token shared by the connector and the privileged updater sidecar. Empty makes
# the sidecar refuse work and /system update all fall back to host instructions;
# the socket-mounted sidecar still runs (remove the service to drop that surface).
# install.sh generates one when it is empty.
DSH_UPDATER_TOKEN=
# GID of the host's docker group, so the updater can use the socket without
# running as root: `getent group docker | cut -d: -f3`.
DSH_DOCKER_GID=999

# ---- telegram (OPTIONAL) --------------------------------------------------
# Leave DSH_TELEGRAM_BOT_TOKEN empty to run a web-only backend. The adapter is
# then never installed. Add the token later and restart: the next boot installs
# it. Your numeric Telegram user id(s), comma separated — empty rejects everyone.
DSH_TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# The one user id that may run /system update|restart|rollback and /plugin.
# Blank means the owner of the bot chat (an upgraded deployment cannot lock out).
# DSH_ADMIN_USER_ID=

# Which connector plugin to install. Empty means this setup's pinned connector;
# any `dsh plugin add` ref works. The package name is derived from it, or set
# DSH_TELEGRAM_PACKAGE explicitly.
#   github:ben7am1n/dsh-telegram                the original chat adapter
# Switching means one `docker compose run --rm dsh reset-plugin` afterwards: the
# old plugin stays installed otherwise and both would poll the same token.
# DSH_TELEGRAM_PLUGIN=
# DSH_TELEGRAM_PACKAGE=

# on = require the adapter, off = keep it disabled even with a token, auto = on
# exactly when a token is present. Turning it off leaves the plugin installed but
# unmounted, so flipping back needs no re-download.
DSH_TELEGRAM_ENABLED=auto

# Optional: send-only publisher bots, comma separated. Each adds ~20 messages/min
# per group; add every publisher to every group as a member (the API cannot).
# The main bot keeps polling, buttons and topic creation.
# Leave empty for a single-bot setup.
DSH_TELEGRAM_PUBLISHER_TOKENS=
# Example: DSH_TELEGRAM_PUBLISHER_TOKENS=123:AAA...,456:BBB...

# ---- supervised restarts (OPTIONAL) ---------------------------------------
# The container runs the runtime under a supervisor, so it can restart itself
# and roll a bad plugin back. A trial restart opens a window; without /confirm
# in Telegram it restores the last committed state. Defaults are fine.
DSH_TRIAL_SECONDS=300
DSH_BOOT_GRACE_SECONDS=120
# One name, two deadlines: the supervisor's connector/component jobs default to
# 900s, the updater's setup apply to 1800s. The compose updater service does not
# read this file, so in docker mode only the supervisor's 900 is tunable here.
DSH_UPDATE_TIMEOUT_SECONDS=900

# ---- time (OPTIONAL) ------------------------------------------------------
# Zone used to read times typed into the bot (scheduled runs, later surfaces).
# Display is client-side: Telegram renders deadlines in the reader's own zone.
# The bot's /timezone command stores the same value without editing this file.
# Leave empty for UTC.
DSH_TIMEZONE=
# Example: DSH_TIMEZONE=Europe/Minsk

# ---- permissions ----------------------------------------------------------
# Container = boundary, so the harness itself is unconfined inside it.
# Set to workspace-write only if you also make a nested sandbox work.
DSH_PERMISSION_MODE=danger-full-access

# ---- managed by install.sh ------------------------------------------------
# install.sh appends values of its own to the generated .env: MODE, DESIGN,
# DSH_SETUP_VERSION, DSH_DESIGN_ENABLED, PENPOT_*, DSH_UPDATER_URL and the UID
# values. `MODE` is load-bearing (update.sh reads it); the rest are rewritten on
# the next install. Prefer `./install.sh` over hand-editing those.
