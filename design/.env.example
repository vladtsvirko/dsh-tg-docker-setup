# Answers for the optional design stack (Penpot on Podman + the penpot CLI).
#
# install.sh writes this file on first use and fills the generated secrets.
# Copy it by hand only when you want to run the stack without the installer.

# Where the design frontend is published. Must exist on this machine.
DSH_BIND_IP=127.0.0.1
DSH_DESIGN_PORT=8090
# HTTPS front for the browser (the clipboard API needs a secure origin).
# The certificate is signed by design/certs/ca.crt; trust that CA once.
DSH_DESIGN_TLS_PORT=8443

# Generated by install.sh; change them only before the first start.
PENPOT_DB_PASSWORD=change-me
PENPOT_SECRET_KEY=change-me

# Create this in Penpot: Settings -> Access tokens. The CLI and the plugin use it.
PENPOT_ACCESS_TOKEN=
