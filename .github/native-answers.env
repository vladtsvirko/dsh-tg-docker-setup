# Answers for the native smoke workflow (.github/workflows/native-smoke.yml).
# The runner is disposable, so the port and the updater token are fixed values.
DIR=/srv/dsh-ci
DSH_PORT=4311
DSH_BIND_IP=127.0.0.1
DSH_PUBLIC_URL=http://127.0.0.1:4311/
DSH_RESOURCE_PERCENT=25
DSH_UPDATER_TOKEN=ci-updater-token
