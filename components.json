{
  "version": 1,
  "components": {
    "design": {
      "label": "Design (Penpot)",
      "description": "Penpot and the penpot CLI",
      "compose": "design/compose.yaml",
      "projectDir": "design",
      "envFile": "design/.env",
      "template": "design/.env.example",
      "flag": "DSH_DESIGN_ENABLED",
      "health": {
        "url": "http://{bind}:{port}/",
        "codes": [
          200,
          302,
          303,
          304
        ]
      },
      "config": {
        "port": {
          "label": "Penpot port",
          "env": "DSH_DESIGN_PORT",
          "default": 8090,
          "min": 1024,
          "max": 65535
        }
      },
      "agent": {
        "urlEnv": "PENPOT_API_URL",
        "tokenEnv": "PENPOT_ACCESS_TOKEN",
        "cli": "penpot"
      }
    }
  }
}
